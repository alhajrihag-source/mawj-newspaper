            showToast('تمت إضافة الفيديو إلى الموج TV');
        }

        // تصدير ونسخ كود HTML الكامل للصفحة
        function getCompleteHtmlDocument() {
            return '&lt;!DOCTYPE html&gt;\n' + document.documentElement.outerHTML;
        }

        function refreshHtmlSourcePreview() {
            const pre = document.getElementById('fullHtmlSourceText');
            if (pre) {
                pre.textContent = getCompleteHtmlDocument();
            }
        }

        function copyFullPageHtml() {
            copyToClipboardFallback(getCompleteHtmlDocument(), 'تم نسخ كامل كود HTML لصحيفة الموج بنجاح');
        }

        function toggleHtmlPreviewBox() {
            const box = document.getElementById('htmlSourceContainer');
            const label = document.getElementById('toggleCodeBtnLabel');
            refreshHtmlSourcePreview();
            const isHidden = box.classList.contains('hidden');
            box.classList.toggle('hidden', !isHidden);
            label.textContent = isHidden ? 'إخفاء الكود' : 'عرض / إخفاء الكود';
        }

        // تنبيه بصري
        function showToast(message) {
            const toast = document.getElementById('toastBanner');
            document.getElementById('toastText').textContent = message;
            toast.classList.remove('translate-y-24', 'opacity-0');
            setTimeout(() =&gt; {
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 3400);
        }

        window.addEventListener('click', (e) =&gt; {
            const readerModal = document.getElementById('articleReaderModal');
            const editorModal = document.getElementById('editorModal');
            if (e.target === readerModal) closeArticleReaderModal();
            if (e.target === editorModal) closeEditorModal();
        });

        window.onload = function() {
            loadStore();
            renderHeroSection();
            renderArticlesGrid();
            renderMostRead();
            renderVideosGrid();
            refreshHtmlSourcePreview();
        };
