            const artForm = document.getElementById('newArticleForm');
            const vidForm = document.getElementById('newVideoForm');
            const btnArt = document.getElementById('modeArticleBtn');
            const btnVid = document.getElementById('modeVideoBtn');

            if (mode === 'article') {
                artForm.classList.remove('hidden');
                vidForm.classList.add('hidden');
                btnArt.className = 'flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg bg-white text-navy-900 shadow-sm transition';
                btnVid.className = 'flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg text-slate-600 hover:text-navy-900 transition';
            } else {
                artForm.classList.add('hidden');
                vidForm.classList.remove('hidden');
                btnVid.className = 'flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg bg-white text-navy-900 shadow-sm transition';
                btnArt.className = 'flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg text-slate-600 hover:text-navy-900 transition';
            }
        }

        function submitNewArticle(e) {
            e.preventDefault();
            const title = document.getElementById('artTitleInput').value.trim();
            const category = document.getElementById('artCatInput').value;
            const author = document.getElementById('artAuthorInput').value.trim() || 'زاد الهاجري — رئيس التحرير';
            const rawText = document.getElementById('artBodyInput').value.trim();
            const isBreaking = document.getElementById('artBreakingCheck').checked;

            const catLabels = {
                'opinion': 'الافتتاحية والرأي',
                'politics': 'سياسة ودولي',
                'economy': 'اقتصاد وطاقة',
                'tech': 'تكنولوجيا وأسواق'
            };

            const paragraphs = rawText.split('\n').map(line => line.trim()).filter(Boolean);
            const newItem = {
                id: 'art-' + Date.now(),
                title,
                category,
                categoryLabel: catLabels[category],
                author,
                date: 'الجمعة 20 نوفمبر 2026 — جديد',
                image: `https://placehold.co/800x460/0B132B/D4AF37?text=${encodeURIComponent(catLabels[category])}`,
                summary: paragraphs[0].slice(0, 165) + (paragraphs[0].length > 165 ? '...' : ''),
                paragraphs
            };

            articlesData.unshift(newItem);
            saveStore();

            if (isBreaking) {
                const track = document.getElementById('breakingTickerTrack');
                track.innerHTML = `<span class="mx-5 text-urgent-600 font-bold">• عاجل: ${title}</span><span class="mx-4 text-gold-600">◆</span>` + track.innerHTML;
            }

            renderHeroSection();
            renderArticlesGrid();
            renderMostRead();
            refreshHtmlSourcePreview();

            document.getElementById('newArticleForm').reset();
            closeEditorModal();
            showToast('تم نشر المادة وحفظها محلياً في صحيفة الموج');
        }

        function parseYoutubeId(input) {
            const match = input.match(/^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/);
            return (match && match[2] && match[2].length === 11) ? match[2] : input.trim();
        }

        function submitNewVideo(e) {
            e.preventDefault();
            const title = document.getElementById('vidTitleInput').value.trim();
            const rawUrl = document.getElementById('vidUrlInput').value.trim();
            const channel = document.getElementById('vidSourceInput').value.trim();
            const youtubeId = parseYoutubeId(rawUrl);

            videosData.unshift({
                id: 'vid-' + Date.now(),
                youtubeId,
                title,
                channel,
                badge: 'مضاف حديثاً'
            });

            saveStore();
            renderVideosGrid();
            refreshHtmlSourcePreview();

            document.getElementById('newVideoForm').reset();
            closeEditorModal();
            showToast('تمت إضافة الفيديو إلى الموج TV');
        }

        function getCompleteHtmlDocument() {
            return '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
        }

        function refreshHtmlSourcePreview() {
            const pre = document.getElementById('fullHtmlSourceText');
            if (pre) {
                pre.textContent = getCompleteHtmlDocument();
            }
        }

        function copyFullPageHtml() {
            copyToClipboardFallback(getCompleteHtmlDocument(), 'تم نسخ كامل كود HTML لصحيفة الموج بنجاح');
        }

        function toggleHtmlPreviewBox() {
            const box = document.getElementById('htmlSourceContainer');
            const label = document.getElementById('toggleCodeBtnLabel');
            refreshHtmlSourcePreview();
            const isHidden = box.classList.contains('hidden');
            box.classList.toggle('hidden', !isHidden);
            label.textContent = isHidden ? 'إخفاء الكود' : 'عرض / إخفاء الكود';
        }

        function showToast(message) {
            const toast = document.getElementById('toastBanner');
            document.getElementById('toastText').textContent = message;
            toast.classList.remove('translate-y-24', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 3400);
        }

        window.addEventListener('click', (e) => {
            const readerModal = document.getElementById('articleReaderModal');
            const editorModal = document.getElementById('editorModal');
            if (e.target === readerModal) closeArticleReaderModal();
            if (e.target === editorModal) closeEditorModal();
        });

        window.onload = function() {
            loadStore();
            renderHeroSection();
            renderArticlesGrid();
            renderMostRead();
            renderVideosGrid();
            refreshHtmlSourcePreview();
        };
    </script>
