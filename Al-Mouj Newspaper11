            &lt;div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6 pb-5 border-b border-cream-200"&gt;
                &lt;div&gt;
                    &lt;div class="inline-flex items-center gap-2 bg-gold-100 text-gold-600 border border-gold-500/30 text-xs font-bold px-3 py-1 rounded-full mb-2"&gt;
                        &lt;i class="fa-solid fa-code"&gt;&lt;/i&gt;
                        &lt;span&gt;تصدير الكود والظهور في بحث قوقل&lt;/span&gt;
                    &lt;/div&gt;
                    &lt;h2 class="press-headline text-2xl sm:text-4xl font-bold text-navy-900"&gt;
                        نسخ كود HTML الكامل وخطوات النشر في قوقل
                    &lt;/h2&gt;
                    &lt;p class="text-slate-600 text-sm mt-1"&gt;
                        انسخ كامل ملف &lt;code class="bg-cream-100 px-1.5 py-0.5 rounded text-navy-900 font-bold"&gt;index.html&lt;/code&gt; المجهّز بوسوم SEO وJSON-LD، ثم ارفعه على استضافة مجانية وفهرسه في Google Search Console.
                    &lt;/p&gt;
                &lt;/div&gt;

                &lt;div class="flex flex-wrap items-center gap-3"&gt;
                    &lt;button type="button" id="copyHtmlBtn" onclick="copyFullPageHtml()" class="bg-navy-900 hover:bg-navy-800 text-gold-400 font-bold text-sm px-5 py-3 rounded-xl transition shadow-md flex items-center gap-2"&gt;
                        &lt;i class="fa-regular fa-copy"&gt;&lt;/i&gt;
                        &lt;span&gt;نسخ كامل كود HTML&lt;/span&gt;
                    &lt;/button&gt;
                    &lt;button type="button" onclick="toggleHtmlPreviewBox()" class="bg-cream-100 hover:bg-cream-200 text-navy-900 border border-cream-200 font-bold text-sm px-4 py-3 rounded-xl transition flex items-center gap-2"&gt;
                        &lt;i class="fa-solid fa-eye"&gt;&lt;/i&gt;
                        &lt;span id="toggleCodeBtnLabel"&gt;عرض / إخفاء الكود&lt;/span&gt;
                    &lt;/button&gt;
                &lt;/div&gt;
            &lt;/div&gt;

            &lt;!-- خطوات الرفع المجاني والفهرسة في Google Search Console --&gt;
            &lt;div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-6"&gt;
                &lt;div class="bg-cream-50 border border-cream-200 rounded-2xl p-5"&gt;
                    &lt;div class="flex items-center gap-2.5 mb-2"&gt;
                        &lt;span class="w-7 h-7 rounded-full bg-navy-900 text-gold-400 font-bold text-xs flex items-center justify-center"&gt;1&lt;/span&gt;
                        &lt;h3 class="font-bold text-navy-900 text-base"&gt;حفظ ملف index.html&lt;/h3&gt;
                    &lt;/div&gt;
                    &lt;p class="text-xs sm:text-sm text-slate-600 leading-relaxed"&gt;
                        اضغط على زر &lt;strong&gt;«نسخ كامل كود HTML»&lt;/strong&gt;، والصقه في محرر نصوص واحفظه باسم &lt;code class="bg-white px-1.5 py-0.5 rounded border text-navy-900"&gt;index.html&lt;/code&gt; بترميز &lt;strong&gt;UTF-8&lt;/strong&gt;.
                    &lt;/p&gt;
                &lt;/div&gt;

                &lt;div class="bg-cream-50 border border-cream-200 rounded-2xl p-5"&gt;
                    &lt;div class="flex items-center gap-2.5 mb-2"&gt;
                        &lt;span class="w-7 h-7 rounded-full bg-navy-900 text-gold-400 font-bold text-xs flex items-center justify-center"&gt;2&lt;/span&gt;
                        &lt;h3 class="font-bold text-navy-900 text-base"&gt;رفع الملف على استضافة مجانية&lt;/h3&gt;
                    &lt;/div&gt;
                    &lt;p class="text-xs sm:text-sm text-slate-600 leading-relaxed"&gt;
                        ارفع الملف مجاناً عبر &lt;strong&gt;Netlify Drop&lt;/strong&gt; أو &lt;strong&gt;GitHub Pages&lt;/strong&gt; أو &lt;strong&gt;Vercel&lt;/strong&gt; للحصول على رابط مباشر يعمل على الإنترنت، وحدّث وسم &lt;code class="bg-white px-1.5 py-0.5 rounded border text-navy-900"&gt;canonical&lt;/code&gt; برابط موقعك النهائي.
                    &lt;/p&gt;
                &lt;/div&gt;

                &lt;div class="bg-cream-50 border border-cream-200 rounded-2xl p-5"&gt;
                    &lt;div class="flex items-center gap-2.5 mb-2"&gt;
                        &lt;span class="w-7 h-7 rounded-full bg-navy-900 text-gold-400 font-bold text-xs flex items-center justify-center"&gt;3&lt;/span&gt;
                        &lt;h3 class="font-bold text-navy-900 text-base"&gt;الفهرسة في Google Search Console&lt;/h3&gt;
                    &lt;/div&gt;
                    &lt;p class="text-xs sm:text-sm text-slate-600 leading-relaxed"&gt;
                        أضف رابط موقعك في &lt;strong&gt;Google Search Console&lt;/strong&gt;، وأثبت الملكية، ثم استخدم أداة &lt;strong&gt;فحص العنوان (URL Inspection)&lt;/strong&gt; واضغط &lt;strong&gt;طلب فهرسة (Request Indexing)&lt;/strong&gt; ليبدأ بالظهور في بحث قوقل.
                    &lt;/p&gt;
                &lt;/div&gt;
            &lt;/div&gt;

            &lt;!-- صندوق الكود القابل للعرض والنسخ --&gt;
            &lt;div id="htmlSourceContainer" class="hidden"&gt;
                &lt;div class="bg-navy-950 text-cream-100 rounded-2xl p-4 border border-navy-800"&gt;
