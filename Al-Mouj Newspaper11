            const text = `${activeReaderArticle.title}\n${activeReaderArticle.author}\n\n${activeReaderArticle.paragraphs.join('\n\n')}\n\n— صحيفة الموج`;
            copyToClipboardFallback(text, 'تم نسخ نص المقال بنجاح');
        }

